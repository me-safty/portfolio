---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { SocialLinks } from '../components/SocialLinks';
import { GitHubActivity } from '../components/GitHubActivity';
import { Experiences } from '../components/Experiences';
import { Projects } from '../components/Projects';
import { Skills } from '../components/Skills';
import { Testimonials } from '../components/Testimonials';
import { UpworkStats } from '../components/UpworkStats';
import { ContactCTA } from '../components/ContactCTA';
import { ScrollToTop } from '../components/ScrollToTop';
import { Section, SectionHeader } from '../components/Section';
import portfolioData from '../data/portfolio.json';

const { profile, socials, experiences, projects, skills, testimonials, quote, github, upwork } = portfolioData;
---

<Layout title={`${profile.name} - Portfolio`} description={profile.bio.split('\n')[0]}>
  <main id="top" class="portfolio-shell mx-auto max-w-[860px] px-4 py-6 sm:px-6 sm:py-10">
    <header class="frame-section overflow-hidden rounded-t-2xl p-4 sm:p-5">
      <div class="dot-grid-panel chrome-dot-box" aria-hidden="true"></div>
    </header>

    <!-- Hero Section -->
    <div class="mb-0">
      <Hero profile={profile} client:load />
      <div class="frame-section border-t-0">
        <SocialLinks socials={socials} client:load />
      </div>
    </div>

    <!-- GitHub Activity -->
    <Section className="border-t-0">
      <GitHubActivity username={github.username} client:load />
    </Section>

    <!-- Upwork Profile -->
    <Section className="border-t-0" id="upwork">
      <SectionHeader title="Upwork" />
      <UpworkStats upwork={upwork} client:load />
    </Section>

    <!-- Experiences -->
    <Section className="border-t-0" id="experience">
      <SectionHeader title="Experiences" />
      <Experiences experiences={experiences} client:load />
    </Section>

    <!-- Projects -->
    <Section className="border-t-0" id="projects">
      <SectionHeader title="Projects" />
      <Projects projects={projects} client:load />
    </Section>

    <!-- Testimonials -->
    <Section className="border-t-0" id="testimonials">
      <SectionHeader title="Client Reviews" />
      <Testimonials testimonials={testimonials} client:load />
    </Section>

    <!-- Skills -->
    <Section className="border-t-0" id="skills">
      <SectionHeader title="Skills & Technologies" />
      <Skills skills={skills} client:load />
    </Section>

    <!-- Newsletter + Quote -->
    <Section className="border-t-0 rounded-b-2xl" id="contact">
      <SectionHeader title="Newsletter" />
      <ContactCTA email={profile.email} quote={quote} client:load />
    </Section>

    <!-- Scroll to top -->
    <ScrollToTop client:load />
  </main>
</Layout>